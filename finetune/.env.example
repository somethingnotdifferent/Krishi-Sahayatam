# =============================================================================
# Copy to .env and fill in what you need. `.env` is git-ignored; never commit a
# real token. The pipeline loads this file automatically if python-dotenv is
# installed (it is a default dependency).
#
# NOTHING here is required to run the pipeline. Every value is optional:
#   * HF_TOKEN   only for gated/private checkpoints
#   * WANDB_*    only if you set training.report_to: ["wandb"]
#   * HF_HOME    only to relocate the multi-GB model cache
# Local metrics.jsonl logging works with none of these set.
# =============================================================================

# ---- Hugging Face ----------------------------------------------------------
# Read by huggingface_hub. Needed only for gated repos (LFM2.5 is public).
# Create at https://huggingface.co/settings/tokens  (read token is enough).
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxx

# Where the model cache lives. LFM2.5-2.6B is ~5 GB, 1.2B ~2.4 GB.
# Point this at a large disk if / is small.
# HF_HOME=/data/hf-cache

# Set to 1 to forbid network access during training (fail if a checkpoint is
# not already cached). Useful for reproducible/offline runs.
# HF_HUB_OFFLINE=0
# TRANSFORMERS_OFFLINE=0

# ---- Weights & Biases (optional) -------------------------------------------
# The pipeline silently skips W&B when WANDB_API_KEY is absent, and says so.
# WANDB_API_KEY=xxxxxxxxxxxxxxxx
# WANDB_PROJECT=mico-agriculture
# WANDB_ENTITY=your-team
# offline keeps runs local (no upload) while still producing local run files.
# WANDB_MODE=offline

# ---- Runtime tuning --------------------------------------------------------
# Comma-separated loggers to raise to DEBUG. By default third-party loggers are
# pinned to WARNING so HF/datasets do not drown the signal.
# LOG_DEBUG_LIBS=1

# NO_COLOR=1            # disable ANSI colour in logs
# TOKENIZERS_PARALLELISM=false

# ---- Config overrides (highest priority, above --set) ----------------------
# Any config path can be overridden with LFM_<SECTION>__<KEY>. Double underscore
# separates sections. Values are parsed as JSON, with true/false/null fallbacks.
#
# Example: run a pilot sweep without editing YAML
#   LFM_TRAINING__LEARNING_RATE=1e-4 LFM_LORA__R=32 lfm-finetune train -c ...
#
# LFM_TRAINING__LEARNING_RATE=2e-4
# LFM_LORA__R=16
# LFM_LORA__ALPHA=32
